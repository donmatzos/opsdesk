# Copy to .env (git-ignored) and fill in. Never commit .env.
# Database password for the postgres container:
POSTGRES_PASSWORD=
# Password the app uses (compose profile "app" and local runs); same value as above:
SPRING_DATASOURCE_PASSWORD=
# Bearer token for the MCP endpoint /mcp (generate one, e.g. `openssl rand -hex 32`). Empty = MCP disabled (503):
OPSDESK_MCP_TOKEN=
# Only for profile "azure" (MOCK, no Azure account; see docs/context/cloud-mocks.md). Leave empty otherwise:
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=
