{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "opsdesk-ui": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/generated/guide",
                "output": "guide"
              }
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/@fontsource/ibm-plex-sans/latin-400.css",
              "node_modules/@fontsource/ibm-plex-sans/latin-600.css",
              "node_modules/@fontsource/jetbrains-mono/latin-400.css",
              "node_modules/@fontsource/jetbrains-mono/latin-600.css"
            ],
            "outputPath": {
              "base": "target/classes/META-INF/resources",
              "browser": ""
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "opsdesk-ui:build:production"
            },
            "development": {
              "buildTarget": "opsdesk-ui:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageReporters": [
              "lcov",
              "text-summary"
            ],
            "reporters": [
              "default",
              [
                "junit",
                {
                  "outputFile": "target/test-reports/vitest-junit.xml"
                }
              ]
            ]
          }
        }
      }
    }
  }
}
